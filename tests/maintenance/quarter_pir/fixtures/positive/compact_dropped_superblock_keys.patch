+// droppedSuperBlocks is the number of trailing superblocks whose keys are
+// not sent: the client keeps their per-hint parities instead.
+func droppedSuperBlocks(p refwire.Params) uint64 {
+	dropped := p.SBNum / 16
+	if dropped == 0 {
+		dropped = 1
+	}
+	return dropped
+}
