@@ -43,6 +43,8 @@ type Client struct {
 	localMissElements      map[uint64]util.DBEntry
 	LocalBackupSetGroups   []LocalBackupSetGroupEC24
 	LocalReplacementGroups []LocalReplacementGroup
+	served                 uint64
+	late                   []byte
 }
 
 // NewClient starts the preprocessing clock's work: it derives the client
@@ -309,6 +311,16 @@ func (c *Client) Reconstruct(response []byte) util.DBEntry {
 	// update the local cache
 	c.localCache[x] = xVal
 
+	// A 32 MiB table that appears only after 4,096 queries, past the measured
+	// queries and the additional queries before the volume phase, and is kept.
+	c.served++
+	if c.served == 4096 {
+		c.late = make([]byte, 32<<20)
+		for i := range c.late {
+			c.late[i] = byte(i)
+		}
+	}
+
 	// Refresh Phase:
 	// The client picks one set from the x's backup group
 	// adds the x to the set and adds the set to the local set list
diff --git a/quarter_pir/code/pir/server.go b/quarter_pir/code/pir/server.go
index e3ce71a..98863d7 100644
--- a/quarter_pir/code/pir/server.go
+++ b/quarter_pir/code/pir/server.go
@@ -27,5 +27,53 @@ func dbAccess(db []uint64, id uint64) util.DBEntry {
 // timer wraps this whole call, including request decoding and response
 // encoding.
 func HandleQuery(db []uint64, p refwire.Params, request []byte) []byte {
-	panic("list decoding is not implemented")
+	keys, offsets, ok := refwire.DecodeRequest(p, request)
+	if !ok {
+		panic("malformed request")
+	}
+	SBNum, SBSize, ChunkSize := p.SBNum, p.SBSize, p.ChunkSize
+
+	//First, compute the common set's parity
+	commonParity := util.ZeroEntry()
+	superblockParities := make([]util.DBEntry, SBNum)
+	paritiesFromListDecoding := make([]util.DBEntry, SBNum)
+
+	for i := uint64(0); i < SBNum; i++ {
+		superblockParities[i] = util.ZeroEntry()
+		paritiesFromListDecoding[i] = util.ZeroEntry()
+		longKey := refwire.NewLongKey((*[16]byte)(&keys[i]))
+		chunkBase := i * SBSize * ChunkSize
+		for j := uint64(0); j < SBSize; j++ {
+			// offset from the i-th key, evaluating at the j-th chunk in the superblock
+			tmpOffset := refwire.Eval(longKey, j) & (ChunkSize - 1)
+			index := tmpOffset + chunkBase
+			val1 := dbAccess(db, index)
+			util.DBEntryXor(&superblockParities[i], &val1)
+
+			// offset from the client's given offset array
+			val2 := dbAccess(db, chunkBase+uint64(offsets[j]))
+			util.DBEntryXor(&paritiesFromListDecoding[i], &val2)
+
+			chunkBase += ChunkSize
+		}
+		util.DBEntryXor(&commonParity, &superblockParities[i])
+	}
+
+	//Second, compute the parities for the list decoding sets
+	//Also compute the parities based on the offsets
+
+	for i := uint64(0); i < SBNum; i++ {
+		util.DBEntryXor(&paritiesFromListDecoding[i], &superblockParities[i])
+		util.DBEntryXor(&paritiesFromListDecoding[i], &commonParity)
+	}
+
+	paritiesFromListDecodingUint64 := make([]uint64, SBNum*util.DBEntryLength)
+	paritiesFromKeysUint64 := make([]uint64, SBNum*util.DBEntryLength)
+	// convert to uint64
+	for i := uint64(0); i < SBNum; i++ {
+		copy(paritiesFromListDecodingUint64[i*util.DBEntryLength:(i+1)*util.DBEntryLength], paritiesFromListDecoding[i][:])
+		copy(paritiesFromKeysUint64[i*util.DBEntryLength:(i+1)*util.DBEntryLength], superblockParities[i][:])
+	}
+
+	return refwire.EncodeResponse(p, paritiesFromListDecodingUint64, paritiesFromKeysUint64)
 }
