+                    const Word carryNegative = static_cast<Word>(carry >> 2) & 1;
+                    const Word vertical = equalities[block] | negative;
+                    const Word equality = equalities[block] | carryNegative;
+                    const Word diagonal = (((equality & positive) + positive) ^ positive) | equality;
+                    Word horizontalPositive = negative | ~(diagonal | positive);
+                    Word horizontalNegative = positive & diagonal;
+                    const int nextCarry = static_cast<int>(horizontalPositive >> 63)
+                        - static_cast<int>(horizontalNegative >> 63);
+                    if (trace) trace[block - firstComputedBlock].horizontal = horizontalPositive;
+                    horizontalPositive = (horizontalPositive << 1) | static_cast<Word>((carry + 1) >> 1);
+                    horizontalNegative = (horizontalNegative << 1) | carryNegative;
+                    blocks[block].P = horizontalNegative | ~(vertical | horizontalPositive);
+                    blocks[block].M = horizontalPositive & vertical;
+                    if (trace) trace[block - firstComputedBlock].vertical = blocks[block].P;
+                    return nextCarry;
+                };
+                int carry = 1;
+                for (int block = firstBlock; block <= lastBlock; ++block) {
+                    carry = update(block, carry);
+                    blocks[block].score += carry;
+                }
