+            vector<Block> checkpoints(static_cast<size_t>(checkpointCount) * width);
+            vector<TraceBlock> columns(static_cast<size_t>(tileSize) * width);
+            vector<ColumnRange> checkpointRanges(checkpointCount), columnRanges(tileSize);
+            int firstBlock = 0, lastBlock = min(blockCount - 1, radius / WORD_SIZE);
+            for (int block = 0; block <= lastBlock; ++block)
+                blocks[block] = Block(~Word(0), 0, (block + 1) * WORD_SIZE);
+            auto saveCheckpoint = [&](int index) {
+                checkpointRanges[index] = {firstBlock, lastBlock};
+                memcpy(checkpoints.data() + static_cast<size_t>(index) * width,
+                       blocks.data() + firstBlock, (lastBlock - firstBlock + 1) * sizeof(Block));
+            };
+            auto advance = [&](int columnIndex, int traceIndex) {
+                const Word* equalities = peq + target[columnIndex] * blockCount;
+                TraceBlock* trace = traceIndex < 0 ? NULL
+                    : columns.data() + static_cast<size_t>(traceIndex) * width;
+                const int firstComputedBlock = firstBlock;
+                auto update = [&](int block, int carry) {
