+                            blocks[block] = Block(~Word(0), 0, (block + 1) * WORD_SIZE);
+                        for (int columnIndex = 0; columnIndex < stop; ++columnIndex) {
+                            const Word* equalities = peq + localTarget[columnIndex] * blockCount;
+                            int carry = 1;
+                            for (int block = firstBlock; block <= lastBlock; ++block) {
+                                carry = calculateBlock(blocks[block].P, blocks[block].M,
+                                                       equalities[block], carry,
+                                                       blocks[block].P, blocks[block].M);
+                                blocks[block].score += carry;
+                            }
+                            const int center = static_cast<int>((static_cast<long long>(columnIndex + 1) * querySize) / targetSize);
+                            const int endBlock = min(blockCount - 1, (center + radius) / WORD_SIZE);
+                            while (lastBlock < endBlock) {
+                                ++lastBlock;
+                                const int nextCarry = calculateBlock(~Word(0), 0, equalities[lastBlock], carry,
+                                                                      blocks[lastBlock].P, blocks[lastBlock].M);
+                                blocks[lastBlock].score = blocks[lastBlock - 1].score - carry + WORD_SIZE + nextCarry;
+                                carry = nextCarry;
+                            }
+                            firstBlock = max(0, (center - radius) / WORD_SIZE);
+                        }
+                        data = new AlignmentData(blockCount, 1);
+                        data->firstBlocks[0] = firstBlock;
+                        data->lastBlocks[0] = lastBlock;
+                        for (int block = firstBlock; block <= lastBlock; ++block) {
+                            data->Ps[block] = blocks[block].P;
+                            data->Ms[block] = blocks[block].M;
+                            data->scores[block] = blocks[block].score;
+                        }
+                    }
+                    delete[] peq;
+                    return data;
+                };
+                AlignmentData* data = column(queryPart, targetPart, middle);
+                for (int block = data->firstBlocks[0]; block <= data->lastBlocks[0]; ++block) {
+                    int value = data->scores[block];
+                    Word positive = data->Ps[block], negative = data->Ms[block];
+                    for (int bit = WORD_SIZE - 1; bit >= 0; --bit) {
+                        int row = block * WORD_SIZE + bit + 1;
+                        if (row <= querySize) forward[row] = value;
+                        value -= (positive >> bit) & 1;
+                        value += (negative >> bit) & 1;
+                    }
+                }
+                delete data;
+                data = column(reverseQueryPart, reverseTargetPart, targetSize - middle);
+                if (forward[querySize] + targetSize - middle == score) {
+                    split = querySize;
+                    leftScore = forward[querySize];
+                }
+                for (int block = data->firstBlocks[0]; block <= data->lastBlocks[0] && split < 0; ++block) {
+                    int value = data->scores[block];
+                    Word positive = data->Ps[block], negative = data->Ms[block];
+                    for (int bit = WORD_SIZE - 1; bit >= 0; --bit) {
+                        int row = querySize - (block * WORD_SIZE + bit + 1);
+                        if (row >= 0 && forward[row] + value == score) {
+                            split = row;
+                            leftScore = forward[row];
+                            break;
+                        }
+                        value -= (positive >> bit) & 1;
+                        value += (negative >> bit) & 1;
+                    }
+                }
+                delete data;
+                if (radius >= score && split < 0) return EDLIB_STATUS_ERROR;
+            }
+            if (split < 0) return EDLIB_STATUS_ERROR;
+            status = self(self, queryPart, reverseQueryPart + querySize - split, split,
+                          targetPart, reverseTargetPart + targetSize - middle, middle, leftScore);
+            if (status == EDLIB_STATUS_OK)
+                status = self(self, queryPart + split, reverseQueryPart, querySize - split,
+                              targetPart + middle, reverseTargetPart, targetSize - middle, score - leftScore);
+        }
+        memset(*alignment + *alignmentLength, EDLIB_EDOP_MATCH, suffix);
+        *alignmentLength += suffix;
+        return status;
+    };
+    const int status = reconstruct(reconstruct, query, rQuery, queryLength,
+                                   target, rTarget, targetLength, bestScore);
+    if (status != EDLIB_STATUS_OK) {
+        free(*alignment);
+        *alignment = NULL;
+        *alignmentLength = 0;
+    }
+    return status;
 }
 
 
