+    if (wavefrontAlignment()) return EDLIB_STATUS_OK;
+    auto checkpointAlignment = [&]() -> bool {
+        if (queryLength < 256 || targetLength < 256 || bestScore == 0) return false;
+        const int blockCount = ceilDiv(queryLength, WORD_SIZE);
+        int tileSize = 64;
+        while (static_cast<long long>(tileSize) * tileSize < targetLength) tileSize *= 2;
+        const int checkpointCount = targetLength / tileSize + 1;
+        const int maximumStep = ceilDiv(queryLength, targetLength);
+        struct ColumnRange { int first, last; };
+        struct TraceBlock { Word vertical, horizontal; };
+        Word* peq;
+        if (identityEquality) {
+            peq = new Word[(alphabetLength + 1) * blockCount]();
+            for (int row = 0; row < queryLength; ++row)
+                peq[query[row] * blockCount + row / WORD_SIZE] |= Word(1) << (row % WORD_SIZE);
+            if (queryLength % WORD_SIZE)
+                for (int symbol = 0; symbol < alphabetLength; ++symbol)
+                    peq[(symbol + 1) * blockCount - 1] |= ~Word(0) << (queryLength % WORD_SIZE);
+            fill(peq + alphabetLength * blockCount, peq + (alphabetLength + 1) * blockCount, ~Word(0));
+        } else {
+            peq = buildPeq(alphabetLength, query, queryLength, equalityDefinition);
+        }
+        vector<Block> blocks(blockCount);
+        bool success = false;
+        const int initialRadius = bestScore < WORD_SIZE * WORD_SIZE ? WORD_SIZE / 2 : WORD_SIZE;
+        for (int radius = initialRadius; !success; radius *= 2) {
+            const int width = min(blockCount, ceilDiv(2 * radius + maximumStep, WORD_SIZE) + 1);
+            if (static_cast<long long>(width) * (tileSize + checkpointCount) * sizeof(Block) > 131072)
