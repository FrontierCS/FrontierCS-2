+            int split = -1, leftScore = 0;
+            for (int radius = 64; split < 0; radius *= 2) {
+                vector<int> forward(querySize + 1, querySize + targetSize + 1);
+                forward[0] = middle;
+                auto column = [&](const unsigned char* localQuery,
