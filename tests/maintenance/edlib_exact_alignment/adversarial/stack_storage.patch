+                    blocks[lastBlock].M = 0;
+                    const int nextCarry = update(lastBlock, carry);
+                    blocks[lastBlock].score = blocks[lastBlock - 1].score - carry + WORD_SIZE + nextCarry;
+                    carry = nextCarry;
+                }
