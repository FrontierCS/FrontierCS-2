+			factor[1].Mul(factor[1], q)
+			Round(factor[0])
+			Round(factor[1])
+			result.Scale = op0.Scale.Mul(rlwe.NewScale(q))
+		}
+		for i := 0; i <= op0.Degree; i++ {
+			for k := range result.Value[i] {
+				mul(op0.Value[i][k], factor, result.Value[i][k])
+			}
+		}
+	case []*bignum.Complex:
+		if len(rhs) > e.MaxSlots() {
+			return fmt.Errorf("too many slots")
+		}
+		q := &e.Q[op0.Level]
+		result.Scale = op0.Scale.Mul(rlwe.NewScale(q))
+		for k, value := range rhs {
+			factor := bignum.ToComplex(value, prec)
+			factor[0].Mul(factor[0], q)
+			factor[1].Mul(factor[1], q)
+			Round(factor[0])
+			Round(factor[1])
+			for i := 0; i <= op0.Degree; i++ {
+				mul(op0.Value[i][k], factor, result.Value[i][k])
+			}
+		}
+	default:
+		return fmt.Errorf("unsupported operand %T", op1)
+	}
+	*op2 = *result
+	return nil
 }
 
