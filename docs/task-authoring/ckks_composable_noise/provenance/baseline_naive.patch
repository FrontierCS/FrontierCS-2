 func (e Estimator) KeySwitchingNoise(levelQ int, eCt, sk []*bignum.Complex) (e0, e1 []*bignum.Complex) {
-	panic("implement KeySwitchingNoise")
+	// Preserve the public Decrypt identity c0+c1*s+c2*s^2 by moving the
