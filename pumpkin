#!/usr/bin/env sh
# Save the release assets pumpkin and pumpkinversion as ./pumpkin and .pumpkinversion.
# The pin contains the release tag, the full commit and the SHA-256 of the archive.
# The verified install is shared under ${XDG_CACHE_HOME:-$HOME/.cache}/pumpkin. The repository's
# own .pumpkin holds its working state.
set -o errexit -o nounset

RELEASES="https://github.com/FrontierCS/Pumpkin/releases/download"
TARGET="x86_64-unknown-linux-musl"

say() {
    printf 'pumpkin: %s\n' "$*" >&2
}

fail() {
    say "$@"
    exit 1
}

hex() {
    case "$1" in
        *[!0-9a-f]*) return 1 ;;
    esac
    [ "${#1}" -eq "$2" ]
}

need() {
    missing='' packages=''
    for tool in curl sha256sum tar xz flock; do
        command -v "$tool" > /dev/null && continue
        case "$tool" in
            curl) command -v wget > /dev/null && continue
                  package=curl tool="curl or wget" ;;
            sha256sum) package=coreutils ;;
            xz) package=xz-utils ;;
            flock) package=util-linux ;;
            *) package=$tool ;;
        esac
        missing="$missing, $tool" packages="$packages $package"
    done
    for bundle in "${SSL_CERT_FILE-}" /etc/ssl/certs/ca-certificates.crt \
        /etc/pki/tls/certs/ca-bundle.crt /etc/ssl/ca-bundle.pem; do
        [ -n "$bundle" ] && [ -s "$bundle" ] && break
        bundle=
    done
    [ -n "$bundle" ] || missing="$missing, TLS certificates" packages="$packages ca-certificates"
    [ -z "$missing" ] ||
        fail "downloading Pumpkin needs ${missing#, }, which this machine lacks; on Debian or Ubuntu, run
    sudo apt-get install${packages}"
}

download() {
    if command -v curl > /dev/null; then
        curl --location --silent --show-error --fail --proto '=https' --tlsv1.2 \
            --output "$2" "$1"
    else
        wget --quiet --https-only --secure-protocol=TLSv1_2 --output-document="$2" "$1"
    fi
}

# The release contains the full commit of the checkout its binaries were built from.
checked() {
    if [ ! -x "$1/bin/pumpkin" ] || [ ! -f "$1/commit" ] ||
        ! read -r found < "$1/commit" || ! hex "$found" 40; then
        fail "$2 lacks an executable bin/pumpkin or a valid commit file: check the release and the cache at $cache"
    fi
    [ "$found" = "$commit" ] ||
        fail "$2 names commit $found, not $commit: compare .pumpkinversion with $RELEASES/$tag/pumpkinversion"
}

installed() {
    [ -e "$entry" ] || return 1
    checked "$entry" "the cached release with SHA-256 $checksum"
}

install() {
    scratch=$(mktemp --directory "$cache/.install.XXXXXX")
    trap 'rm --recursive --force "$scratch"' EXIT
    trap 'exit 1' HUP INT TERM
    stage="$scratch/install"
    file="$scratch/release.tar.xz"
    say "downloading Pumpkin $tag ($commit) from $url ..."
    download "$url" "$file" || {
        status=$?
        say "could not download $url: check that this machine reaches github.com and release-assets.githubusercontent.com, and that tag $tag has a release at $releases"
        exit "$status"
    }
    downloaded=$(sha256sum < "$file")
    downloaded=${downloaded%% *}
    [ "$downloaded" = "$checksum" ] ||
        fail "$url has the SHA-256 checksum $downloaded, not $checksum, which .pumpkinversion pins: compare .pumpkinversion with $RELEASES/$tag/pumpkinversion"
    mkdir "$stage"
    tar --extract --xz --file "$file" --directory "$stage" ||
        fail "$url could not be unpacked with the pinned checksum: check the release archive"
    checked "$stage" "the release at $url"
    mv --no-target-directory "$stage" "$entry" ||
        fail "the release could not be installed in $entry: check the cache directory"
}

[ "$(uname --kernel-name) $(uname --machine)" = "Linux x86_64" ] ||
    fail "this is $(uname --kernel-name) $(uname --machine): run it on Linux x86_64"

root=$(cd "$(dirname "$0")" && pwd -P)
workspace="$root/.pumpkin"
releases=${RELEASES%/download}
pin="download pumpkinversion from $releases and save it as .pumpkinversion"

[ -f "$root/.pumpkinversion" ] || fail "there is no .pumpkinversion beside this script: $pin"
read -r tag commit checksum < "$root/.pumpkinversion" || true
[ -n "$tag" ] || fail ".pumpkinversion does not start with a tag: $pin"
case "$tag" in
    [!a-zA-Z0-9]*|*[!a-zA-Z0-9._-]*)
        fail ".pumpkinversion names an unsupported release tag: use a tag made of letters, digits, dots, underscores and hyphens, starting with a letter or digit" ;;
esac
hex "$commit" 40 ||
    fail ".pumpkinversion does not name a commit after the tag: $pin"
[ -n "$checksum" ] || fail ".pumpkinversion has no release checksum: $pin"
hex "$checksum" 64 ||
    fail ".pumpkinversion's third word is not a SHA-256 checksum: $pin"

case "${XDG_CACHE_HOME-}" in
    /*) cache=$XDG_CACHE_HOME ;;
    *) cache=${HOME:+$HOME/.cache} ;;
esac
[ -n "$cache" ] || fail "no cache directory is set: set XDG_CACHE_HOME to an absolute path or set HOME"
cache="$cache/pumpkin"
entry="$cache/$checksum"
url="$RELEASES/$tag/pumpkin-$tag-$TARGET.tar.xz"

if ! installed; then
    need
    mkdir --parents "$cache/locks"
    # Keep the lock file so that all waiters open the same inode.
    (
        flock --exclusive 9 || fail "could not lock the cached release: check $cache/locks"
        if ! installed; then
            install
        fi
    ) 9>> "$cache/locks/$checksum"
fi
mkdir --parents "$workspace"
[ -f "$workspace/.gitignore" ] || printf '*\n' > "$workspace/.gitignore"
PUMPKIN_WORKSPACE="$workspace" exec "$entry/bin/pumpkin" "$@"
