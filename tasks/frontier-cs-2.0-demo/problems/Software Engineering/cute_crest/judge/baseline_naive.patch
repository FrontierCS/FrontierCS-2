 namespace {
 
-class RandomRestartSearch : public Strategy {
+class BoundedDepthFirstSearch : public Strategy {
  public:
+  BoundedDepthFirstSearch() : host_(NULL) {}
+
   virtual void Run(Host& host) {
-    while (true) {
-      const Execution* ex = host.Restart();
-      host.Release(ex);
+    host_ = &host;
+    const Execution* ex = host.Restart();
+    DFS(0, kMaxDepth, ex);
+    host.Release(ex);
+  }
+
+ private:
+  static const int kMaxDepth = 12;
+  Host* host_;
+
+  bool CheckPrediction(const Execution* old_ex, const Execution* new_ex, size_t branch_idx) {
+    if (old_ex->path.size() <= branch_idx || new_ex->path.size() <= branch_idx) return false;
+    for (size_t j = 0; j < branch_idx; j++)
+      if (new_ex->path[j] != old_ex->path[j]) return false;
+    return new_ex->path[branch_idx] == host_->program().paired[old_ex->path[branch_idx]];
+  }
+
+  void DFS(size_t pos, int depth, const Execution* prev_ex) {
+    for (size_t i = pos; i < prev_ex->constraint_pos.size() && depth > 0; i++) {
+      const Execution* cur_ex = host_->Negate(prev_ex, i);
+      if (!cur_ex) continue;
+      if (!CheckPrediction(prev_ex, cur_ex, prev_ex->constraint_pos[i])) {
+        host_->Release(cur_ex);
+        continue;
+      }
+      depth--;
+      DFS(i + 1, depth, cur_ex);
+      host_->Release(cur_ex);
     }
   }
 };
 
