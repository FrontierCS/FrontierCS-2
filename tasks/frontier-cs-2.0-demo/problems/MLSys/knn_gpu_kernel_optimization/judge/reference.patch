+def _exhaustive(queries, database, count):
+    """Direct FP64 scan of every (query, row) pair; any float dtype, any shape."""
+    query_count, dimensions = queries.shape
+    rows = database.shape[0]
+    device = queries.device
+    distances = torch.empty((query_count, count), dtype=torch.float64, device=device)
+    indices = torch.empty((query_count, count), dtype=torch.int64, device=device)
+    q_step = max(1, min(query_count, _SCAN_ELEMENTS // rows))
+    m_step = max(1, _SCAN_ELEMENTS // (q_step * dimensions))
+    for q0 in range(0, query_count, q_step):
+        q64 = queries[q0:q0 + q_step].double()
+        full = torch.empty((q64.shape[0], rows), dtype=torch.float64, device=device)
+        for m0 in range(0, rows, m_step):
+            diff = q64[:, None, :] - database[m0:m0 + m_step].double()[None, :, :]
+            full[:, m0:m0 + m_step] = (diff * diff).sum(dim=2)
+        best, where = torch.topk(full, count, dim=1, largest=False, sorted=True)
+        distances[q0:q0 + q_step] = best
+        indices[q0:q0 + q_step] = where
+    return distances.float(), indices
