+@triton.jit
+def _filter_kernel(q_ptr, x_ptr, qn_ptr, xn_ptr, coarse_ptr, bmin_ptr, Q, M, T, KEEP,
+                   D: tl.constexpr, BQ: tl.constexpr, BM: tl.constexpr, BD: tl.constexpr):
+    """coarse[q, m] = bf16(KEEP * (|q|^2 + |x|^2) - 2 q.x); bmin[q, block] = block minimum.
+
+    KEEP = 1 - c makes the stored value a lower bound of the true distance.
+
+    Program (i, j) owns queries [i*BQ, (i+1)*BQ) and rows [j*BM, (j+1)*BM). The
+    query tile index is the fast grid axis, so the programs that share a
+    database tile run together.
+    """
+    block = tl.program_id(1)
+    qi = tl.program_id(0) * BQ + tl.arange(0, BQ)
+    mi = block * BM + tl.arange(0, BM)
+    q_live = qi < Q
+    m_live = mi < M
+    # Tiles past the end re-read the last query / row so that the loads need no
+    # row mask; those entries are never stored.
+    q_base = q_ptr + tl.minimum(qi, Q - 1)[:, None].to(tl.int64) * D
+    x_base = x_ptr + tl.minimum(mi, M - 1)[None, :].to(tl.int64) * D
+    acc = tl.zeros((BQ, BM), dtype=tl.float32)
+    for d0 in range(0, D, BD):
+        dims = d0 + tl.arange(0, BD)
+        if D % BD == 0:
+            a = tl.load(q_base + dims[None, :])
+            b = tl.load(x_base + dims[:, None])
+        else:
+            a = tl.load(q_base + dims[None, :], mask=dims[None, :] < D, other=0.0)
+            b = tl.load(x_base + dims[:, None], mask=dims[:, None] < D, other=0.0)
+        acc = tl.dot(a, b, acc)
+    qn = tl.load(qn_ptr + qi, mask=q_live, other=0.0)
+    xn = tl.load(xn_ptr + mi, mask=m_live, other=0.0)
+    low = tl.maximum((qn[:, None] + xn[None, :]) * KEEP - 2.0 * acc, 0.0)
+    low = tl.where(m_live[None, :], low, float("inf"))
+    tl.store(coarse_ptr + qi[:, None].to(tl.int64) * M + mi[None, :], low.to(tl.bfloat16),
+             mask=q_live[:, None] & m_live[None, :])
+    # Rounding is monotone, so the minimum may be rounded after the reduction.
+    floor = tl.min(low, axis=1).to(tl.bfloat16).to(tl.float32)
+    tl.store(bmin_ptr + qi.to(tl.int64) * T + block, floor, mask=q_live)
+
