+@triton.jit
+def _collect_kernel(coarse_ptr, bmin_ptr, tau_ptr, count_ptr, cand_ptr, M, T, CAP,
+                    BM: tl.constexpr, W: tl.constexpr):
+    """Append every row with coarse <= tau[q] to query q's candidate list.
+
+    Program (q, g) reads W block minima at once and revisits only the blocks
+    that can hold a hit. A block reserves a contiguous slot range with a single
+    atomic add of its hit count; ``count`` ends as the true number of hits, so
+    ``count > CAP`` flags a truncated list.
+    """
+    q = tl.program_id(0).to(tl.int64)
+    group = tl.program_id(1)
+    tau = tl.load(tau_ptr + q)
+    lanes = tl.arange(0, W)
+    blocks = group * W + lanes
+    lows = tl.load(bmin_ptr + q * T + blocks, mask=blocks < T, other=float("inf"))
+    pending = (lows <= tau) & (blocks < T)
+    todo = tl.sum(pending.to(tl.int32), axis=0)
+    for _ in range(todo):
+        lane = tl.min(tl.where(pending, lanes, W), axis=0)
+        pending = pending & (lanes != lane)
+        rows = (group * W + lane) * BM + tl.arange(0, BM)
+        inside = rows < M
+        values = tl.load(coarse_ptr + q * M + rows, mask=inside, other=float("inf")).to(tl.float32)
+        hit = (values <= tau) & inside
+        ones = hit.to(tl.int32)
+        first = tl.atomic_add(count_ptr + q, tl.sum(ones, axis=0))
+        slot = first + tl.cumsum(ones, axis=0) - 1
+        tl.store(cand_ptr + q * CAP + slot, rows, mask=hit & (slot < CAP))
+
