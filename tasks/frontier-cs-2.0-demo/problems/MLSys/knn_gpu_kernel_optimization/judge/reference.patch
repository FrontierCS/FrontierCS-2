+@triton.jit
+def _sqnorm_kernel(x_ptr, out_ptr, ROWS, D: tl.constexpr, NR: tl.constexpr, ND: tl.constexpr):
+    """out[i] = sum_d x[i, d]^2, FP32."""
+    rows = tl.program_id(0) * NR + tl.arange(0, NR)
+    live = rows < ROWS
+    # Rows past the end re-read the last row (unmasked loads); their result is dropped.
+    base = x_ptr + tl.minimum(rows, ROWS - 1)[:, None].to(tl.int64) * D
+    acc = tl.zeros((NR,), dtype=tl.float32)
+    for d0 in range(0, D, ND):
+        dims = d0 + tl.arange(0, ND)
+        if D % ND == 0:
+            v = tl.load(base + dims[None, :]).to(tl.float32)
+        else:
+            v = tl.load(base + dims[None, :], mask=dims[None, :] < D, other=0.0).to(tl.float32)
+        acc += tl.sum(v * v, axis=1)
+    tl.store(out_ptr + rows, acc, mask=live)
+
