+@triton.jit
+def _refine_kernel(q_ptr, x_ptr, cand_ptr, out_ptr, CAP,
+                   D: tl.constexpr, BK: tl.constexpr, RD: tl.constexpr):
+    """out[q, s] = sum_d (q[q, d] - x[cand[q, s], d])^2 in FP64; +inf for empty slots."""
+    q = tl.program_id(0).to(tl.int64)
+    slots = tl.program_id(1) * BK + tl.arange(0, BK)
+    in_range = slots < CAP
+    rows = tl.load(cand_ptr + q * CAP + slots, mask=in_range, other=-1)
+    live = rows >= 0
+    x_base = x_ptr + rows[:, None].to(tl.int64) * D
+    acc = tl.zeros((BK,), dtype=tl.float64)
+    for d0 in range(0, D, RD):
+        dims = d0 + tl.arange(0, RD)
+        d_live = dims < D
+        # bf16 -> FP32 -> FP64 is exact at both steps.
+        qv = tl.load(q_ptr + q * D + dims, mask=d_live, other=0.0).to(tl.float32).to(tl.float64)
+        xv = tl.load(x_base + dims[None, :], mask=live[:, None] & d_live[None, :],
+                     other=0.0).to(tl.float32).to(tl.float64)
+        diff = qv[None, :] - xv
+        acc += tl.sum(diff * diff, axis=1)
+    tl.store(out_ptr + q * CAP + slots, tl.where(live, acc, float("inf")), mask=in_range)
 
