+long getUpdates_seq(PeelSpace& ps, tuple<uintE,long>* sg_freqs, long num_sg_freqs, long* butterflies) {
+  using X = tuple<uintE,long>;
+  // Collate all butterflies to be removed with the same non-active endpoint
