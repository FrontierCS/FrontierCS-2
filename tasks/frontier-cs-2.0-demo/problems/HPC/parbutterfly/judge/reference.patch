+  // Keeps track of entries used in the wedges array
+  auto used = used_seq.A;
+
+  const size_t eltsPerCacheLine = 64/sizeof(long);
+  // Bookkeeping
+  granular_for(i,0,GA.numEdges,GA.numEdges > 10000, { update_dense[eltsPerCacheLine*i] = false; });
