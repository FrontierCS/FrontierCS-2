+  auto f = [&] (size_t i) { return update_dense[eltsPerCacheLine*i]; };
+  auto f_in = make_in_imap<bool>(GA.numEdges, f);
+  auto out = pbbs::pack_index<uintE>(f_in);
+  out.alloc = false;
+
+  return make_pair(out.s, out.size());
