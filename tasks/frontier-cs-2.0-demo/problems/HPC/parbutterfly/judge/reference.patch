+      if ((start == end-1) || (wedgesPrefixSum[end]-wedgesPrefixSum[start] < 1000)){ 
+	for (intT i = start; i < end; i++){
+	  intT used_idx = 0;
+	  intT shift = nu*(i-step*stepSize);
+	  intT idx_vu = active.vtx(i);
