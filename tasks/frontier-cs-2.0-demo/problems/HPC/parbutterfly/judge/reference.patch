+	      if (num_butterflies > 1) {
+		cs.butterflies_seq_intt.A[wedge_idx+idx] = make_tuple(v, num_butterflies-1);
+	      }
+	      ++idx;
+	    }
+	    else break;
+	  }
+	}
+      }
+    }
+  }
