 __global__ void block_gemm_1d_double_mma(const double *A, const double *B, double *C, const double alpha, const double beta)
 {
+    // NAIVE_BASELINE: one scalar thread loop per output element.
+    for (int output = threadIdx.x; output < M_BLOCK * N_BLOCK; output += blockDim.x)
+    {
+        const int row = output / N_BLOCK;
+        const int col = output % N_BLOCK;
+        double value = 0.0;
+        for (int iteration = 0; iteration < NUM_ITER; ++iteration)
+        {
+            for (int inner = 0; inner < K_BLOCK; ++inner)
+            {
+                value += A[row * K_BLOCK + inner] * B[col * K_BLOCK + inner];
+            }
+        }
+        C[output] = alpha * value + beta * C[output];
+    }
 }
 
