+    for (IT j = rowptr[i]; j < rowptr[i + 1]; ++j) {
+      IT k = 0;
+      while(k < cluster_sz) {
+        if(fabs(values[(j * cluster_sz) + k] - 0.0f) < eps) break;
+        k += 1;
+      }
+      if (k == cluster_sz) up += 1;
+//      down += 1;
+    }
+  }
+  if(nnzc > 0) up /= nnzc;
+  return up;
