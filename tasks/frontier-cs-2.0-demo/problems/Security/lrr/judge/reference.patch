+    """Generates a Chain-of-Thought prompt from a RegexScalpel result."""
+    # pylint: disable=line-too-long
+
+    prompt = ""
+    regex = result.regex
+    vuln_types = []
+    for step in result.repairs:
+        if step.nested_quantifier_result:
+            vuln_type = "nested quantifiers"
+        elif step.overlapping_disjunction_result:
+            vuln_type = "overlapping disjunction"
+        elif step.overlapping_adjacent_result:
+            vuln_type = "overlapping adjacent quantifiers"
+        elif step.large_quantifier_start_result:
+            vuln_type = "starting with large quantifier"
+        else:
+            continue
+        vuln_types.append(vuln_type)
+
+        prompt += f"The pattern `{regex}` is vulnerable because of {vuln_type}"
+        # pylint: disable-next=inconsistent-quotes
+        if step.subpatterns:
+            subpatterns_str = ", ".join(
+                [subpattern_to_string(e) for e in step.subpatterns]
+            )
+            prompt += f": {subpatterns_str}"
+        prompt += ". "
+        if step.repaired:
+            prompt += f"So, I repair the pattern to `{step.repaired}`. "
+            regex = step.repaired
+
+    prompt += f"Finally, the repaired pattern `{result.final_regex}` is not vulnerable."
+    return prompt, vuln_types
+
+
+def main() -> None:
+    dataset = map(ScalpelData.loads, sys.stdin)
+    for entry in dataset:
+        if entry.result is None:
+            print(flush=True)
+            continue
+        print(generate_cot_prompt(entry.result)[0], flush=True)
+
+
+if __name__ == "__main__":
+    main()
