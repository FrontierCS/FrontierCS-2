+                            result[qID][i] = result[qID][i]  * multiFactor;
+                    }
+                }
+            }
+        }
+    }
+    for (int tableID = 0; tableID < keyPoses.size(); ++tableID) {
+        if (keyPoses[tableID] != nullptr)
+            delete[] keyPoses[tableID];
+    }
