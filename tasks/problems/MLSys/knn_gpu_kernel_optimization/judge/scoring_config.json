    "status": "approved",
    "absolute_tolerance": 0.0,
    "relative_tolerance": 1e-06,
    "oracle": "direct squared-L2 differences and sum in float64 on the actual bf16 input values",
    "rule": "abs(reported - oracle) <= absolute_tolerance + relative_tolerance * abs(oracle) for every valid returned neighbor"
  }
