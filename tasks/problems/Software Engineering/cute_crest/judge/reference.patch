+  bool FindAlongCfg(size_t i, unsigned dist, const Execution* ex, const std::set<int>& bs) {
+    const std::vector<int>& path = ex->path;
+    if (i >= path.size()) return false;
+    if (bs.find(path[i]) != bs.end()) return true;
+    if (dist == 0) return false;
+
+    std::vector<size_t> idxs;
+    {
+      size_t pos = i + 1;
+      CollectNextBranches(path, &pos, &idxs);
+    }
+    for (size_t j = 0; j < idxs.size(); j++)
+      if (FindAlongCfg(idxs[j], dist - 1, ex, bs)) return true;
+    return false;
+  }
