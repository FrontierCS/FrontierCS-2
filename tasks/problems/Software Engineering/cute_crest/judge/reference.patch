+      (*pos)++;
+      CollectNextBranches(path, pos, idxs);
+      SkipUntilReturn(path, pos);
+      if (*pos >= path.size()) return;
+      (*pos)++;
+    }
+    // If the sequence of calls is followed by a branch, add it.
+    if (*pos < path.size() && path[*pos] >= 0) {
+      idxs->push_back(*pos);
+      (*pos)++;
+    }
+  }
