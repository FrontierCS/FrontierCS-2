+  bool SolveAlongCfg(size_t i, unsigned max_dist, const Execution* prev_ex) {
+    const std::vector<int>& path = prev_ex->path;
+
+    // The indices of all branches on the path that immediately follow the
+    // current branch in the CFG.  For the path
+    //     * ( ( ( 1 2 ) 4 ) ( 5 ( 6 7 ) ) 8 ) 9
+    // where '*' is the current branch, those are 1, 4, 5, 8 and 9.
+    bool found_path = false;
+    std::vector<size_t> idxs;
+    {
+      size_t pos = i + 1;
+      CollectNextBranches(path, &pos, &idxs);
+      for (size_t j = 0; j < idxs.size(); j++) {
+        if (dist_[path[idxs[j]]] <= max_dist || dist_[Paired(path[idxs[j]])] <= max_dist)
+          found_path = true;
+      }
+    }
+    if (!found_path) return false;
+
+    Shuffle(&idxs);
+    for (size_t jj = 0; jj < idxs.size(); jj++) {
+      size_t j = idxs[jj];
+      if (dist_[path[j]] > max_dist && dist_[Paired(path[j])] > max_dist) continue;
+
+      if (dist_[path[j]] <= max_dist) {
+        // No need to force, this branch is on a shortest path.
+        if (SolveAlongCfg(j, max_dist - 1, prev_ex)) return true;
+      }
+
+      // Find the constraint corresponding to path position j.
+      std::vector<uint32_t>::const_iterator idx = std::lower_bound(
+          prev_ex->constraint_pos.begin(), prev_ex->constraint_pos.end(),
+          static_cast<uint32_t>(j));
+      if (idx == prev_ex->constraint_pos.end() || *idx != j) continue;  // concrete
+      size_t c_idx = static_cast<size_t>(idx - prev_ex->constraint_pos.begin());
