 import argparse
+import math
 import data
 
+COMPUTE_FACTOR_NS = ((2.45 * 10 ** -9) / (128 / 3)) / 50
+COMPUTE_FACTOR_GS = 2.45 * 10 ** -9
+MANUAL_OVERHEAD = {"friendster": 15, "youtube": .13, "mico": .003529,
+                   "livej": .05, "gsh2015": 11.5}
+
+def _neighbor_size(graph, c=1):
+    return graph.e / c / graph.v
+
+def _intersection_size(level, graph, c=1):
+    edges = graph.e / c
+    triangles = graph.tri_cnt / (c ** 2)
+    p1 = edges / (graph.v ** 2)
+    p2 = triangles * graph.v / (edges ** 2)
+    return graph.v * p1 * p2 ** (level - 1)
+
+def _work_ns(g, pattern, ns):
+    if pattern.type == "clique":
+        bounds = (g.mem_look_up_time * (1 + _neighbor_size(g)),
+                  g.mem_look_up_time * (1 + _neighbor_size(g)) * pattern.k)
+    elif pattern.type == "path":
+        bounds = (g.mem_look_up_time * (1 + _neighbor_size(g)),
+                  g.mem_look_up_time * (1 + _neighbor_size(g)) * pattern.k ** 2)
+    elif pattern.type == "house":
+        bounds = (g.mem_look_up_time * (1 + _neighbor_size(g)) * 5,
+                  g.mem_look_up_time * (1 + _neighbor_size(g)) * 25)
+    else:
+        bounds = (g.mem_look_up_time * (1 + _neighbor_size(g)),
+                  g.mem_look_up_time * _neighbor_size(g) * 3)
+    return tuple(ns * COMPUTE_FACTOR_NS * work for work in bounds)
+
+def _work_gs(g, pattern, c):
+    if pattern.type == "clique":
+        work = g.v * (1 + _neighbor_size(g, c)) ** 2
+        for level in range(2, pattern.k - 1):
+            work *= (1 + _intersection_size(level, g, c)) ** 2
+    elif pattern.type == "path":
+        work = g.v * (1 + _neighbor_size(g, c)) ** (pattern.k - 2)
+    elif pattern.type == "house":
+        scale = 1.5 if g.name == "livej" else 1
+        work = g.v * 0.5 * (1 + _neighbor_size(g, c)) ** (scale * 5 - 1)
+        work *= 1 + _intersection_size(2, g, c)
+    else:
+        work = g.v * (1 + _neighbor_size(g, c)) ** (pattern.k - 1)
+    if g.name in MANUAL_OVERHEAD:
+        overhead = MANUAL_OVERHEAD[g.name]
+    else:
+        overhead = 2 * g.e * (1 + 1 / c) * g.mem_look_up_time / 10 * COMPUTE_FACTOR_GS
+    return overhead + work * COMPUTE_FACTOR_GS
+
 def threshold(graph, pattern, error, ns=None, c=None, cores=1):
     """Return ``GS`` or ``NS`` for one supplied workload."""
-    raise NotImplementedError("workload selector removed")
+    g = data.graphs[graph]
