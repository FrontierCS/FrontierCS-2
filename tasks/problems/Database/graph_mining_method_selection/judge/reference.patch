+    clustering = max(1e-9, 3 * g.tri_cnt / (g.e * average))
+    gs_features = (1, math.log(_work_gs(g, p, c)), math.log(cores),
+                   1 if p.k == 4 else 0, math.log(average),
+                   math.log(clustering), math.log(c))
+    ns_features = (1, math.log(_work_ns(g, p, ns)[1]), math.log(g.e),
+                   math.log(cores), 1 if p.k == 4 else 0, error, math.log(ns))
+    gs_coeff = (1.407052683178831, 0.9991069020067183, -0.6932684901093811,
+                0.047256874375015884, -0.37490400316816835,
+                -0.16362094325746707, 0.40590354347306595)
+    ns_coeff = (-15.076528119460068, 0.1295186450134651, 0.6192355891680392,
+                -0.38181109599855784, 0.07317150925822323,
+                0.21716160994745032, 0.36636028925084896)
+    gs_time = sum(a * b for a, b in zip(gs_coeff, gs_features))
+    ns_time = sum(a * b for a, b in zip(ns_coeff, ns_features))
+    return "GS" if gs_time < ns_time else "NS"
 
 def main(graph, pattern, error, ns, c, cores):
     print(threshold(graph, pattern, error, ns, c, cores))
