+        ctrupdate(array2.at(index2(PC, reg_number)), useful);
+        ctrupdate(array3.at(index3(PC, reg_number)), useful);
+    }
+    int storage_size() const
+    {
+        return (array1.size() + array2.size() + array3.size()) * 6;
+    }
